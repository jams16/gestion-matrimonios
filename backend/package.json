{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:e01": "node scripts/ejecutar-e01.mjs",
    "test:e02": "node scripts/ejecutar-e02.mjs",
    "test:e03": "node scripts/ejecutar-e03.mjs",
    "test:e04": "node scripts/ejecutar-e04.mjs",
    "test:registro-wedding-planner": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/backup/legacy/registro-wedding-planner/registro-wedding-planner.e2e-spec.ts",
    "test:manual:registro-wedding-planner": "node -r ts-node/register scripts/ejecutar-registro-wedding-planner-manual.ts",
    "test:creacion-matrimonio": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/backup/legacy/creacion-matrimonio/creacion-matrimonio.spec.ts",
    "test:manual:creacion-matrimonio": "node -r ts-node/register scripts/ejecutar-creacion-matrimonio-manual.ts",
    "test:gestion-cronograma": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand src/modules/cronograma/application/use-cases/gestionar-cronograma.use-cases.spec.ts src/modules/cronograma/application/use-cases/reprogramar-actividad.use-case.spec.ts",
    "test:invitados": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand src/modules/invitados/application/invitados.service.spec.ts",
    "test:proveedores": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand src/modules/proveedores/application/use-cases/proveedores.use-cases.spec.ts",
    "test:manual:gestion-cronograma": "node -r ts-node/register scripts/ejecutar-gestion-cronograma-manual.ts",
    "datos-base:restaurar": "node -r ts-node/register scripts/restaurar-datos-base.ts",
    "db:migrate:base": "pnpm.cmd exec prisma db migrate && pnpm.cmd datos-base:restaurar",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.9-dev.13",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.0.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "8.0.0-rc.14",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
