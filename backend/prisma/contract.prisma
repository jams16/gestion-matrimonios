// use prisma-next
model Proyecto {
  idProyecto        Uuid            @id @default(uuid())
  nombre            VarChar(150)?
  idPm              Int?            @map("id_pm")
  fechaInicio       DateTime?       @map("fecha_inicio")
  fechaFin          DateTime?       @map("fecha_fin")
  presupuesto       Numeric(12, 2)?
  objetivos         VarChar(1000)?
  necesidades       VarChar(1000)?
  supuestos         VarChar(1000)?
  restricciones     VarChar(1000)?
  alcance           VarChar(1000)?
  idFaseProyecto    Int?            @map("id_fase_proyecto")
  estado            Boolean         @default(true)
  fechaCreacion     DateTime        @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime?       @map("fecha_modificacion")

  projectManager    Usuario?        @relation("proyectos_pm", fields:[idPm], references:[idUsuario], onDelete: Restrict)
  matrimonio        Matrimonio?
  faseProyecto      FaseProyecto?   @relation(fields:[idFaseProyecto], references:[idFaseProyecto], onDelete: Restrict)
  hitos             Hito[]
  actividades       Actividad[]
  timings           Timing[]
  notificaciones    Notificacion[]

  @@index([idPm])
  @@index([idFaseProyecto])

  @@map("gp_proyecto")
}

model Matrimonio {
  idMatrimonio      Uuid                  @id @default(uuid()) @map("id_matrimonio")
  idProyecto        Uuid                  @unique @map("id_proyecto")
  idNovio1          Int?                  @map("id_novio1")
  idNovio2          Int?                  @map("id_novio2")
  fechaMatrimonio   DateTime?             @map("fecha_matrimonio")
  cantidadInvitados Int?                  @map("cantidad_invitados")
  idTipoCeremonia   Int?                  @map("id_tipo_ceremonia")
  ciudadUbicacion   VarChar(6)?           @map("ciudad_ubicacion")
  ideasMoonboard    VarChar(1000)?        @map("ideas_moonboard")
  estado            Boolean?
  fechaCreacion     DateTime              @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime?             @map("fecha_modificacion")

  proyecto          Proyecto              @relation(fields:[idProyecto], references:[idProyecto], onDelete: Restrict)
  novio1            Usuario?              @relation("matrimonios_novio1", fields:[idNovio1], references:[idUsuario], onDelete: Restrict)
  novio2            Usuario?              @relation("matrimonios_novio2", fields:[idNovio2], references:[idUsuario], onDelete: Restrict)
  ubigeo            Ubigeo?               @relation(fields:[ciudadUbicacion], references:[idUbigeo], onDelete: Restrict)
  tipoCeremonia     TipoCeremonia?        @relation(fields:[idTipoCeremonia], references:[idTipoCeremonia], onDelete: Restrict)
  invitados         Invitado[]
  mesas             Mesa[]
  proveedores       MatrimonioProveedor[]

  @@index([idNovio1])
  @@index([idNovio2])
  @@index([ciudadUbicacion])
  @@index([idTipoCeremonia])
  @@map("gp_matrimonio")
}

model TipoCeremonia {
  idTipoCeremonia Int           @id @default(autoincrement()) @map("id_tipo_ceremonia")
  codigo          VarChar(50)   @unique
  nombre          VarChar(100)
  descripcion     VarChar(500)?
  activo          Boolean       @default(true)
  matrimonios     Matrimonio[]

  @@map("gp_tipo_ceremonia")
}

model FaseProyecto {
  idFaseProyecto       Int                  @id @default(autoincrement()) @map("id_fase_proyecto")
  codigo               VarChar(50)          @unique
  nombre               VarChar(100)
  descripcion          VarChar(500)?
  orden                Int
  activo               Boolean              @default(true)
  proyectos            Proyecto[]
  actividadesPlantilla PlantillaActividad[]

  @@map("gp_fase_proyecto")
}

enum cr_tipo_temporal {
  INICIO
  ESCALABLE
  FIJO_EVENTO
  DIA_EVENTO
  POST_EVENTO
}

enum iv_lado_relacion {
  NOVIA
  NOVIO
  AMBOS
  OTRO
}

enum iv_estado_rsvp {
  PENDIENTE
  CONFIRMADO
  NO_ASISTE
}

enum iv_canal_rsvp {
  MANUAL
  DIGITAL
  SISTEMA
}

enum pv_tipo_proveedor {
  PERSONA_NATURAL
  EMPRESA
}

enum pv_moneda {
  PEN
  USD
}

enum pv_estado_seleccion {
  CONSIDERADO
  SELECCIONADO
  DESCARTADO
}

enum pv_prioridad {
  ALTA
  MEDIA
  BAJA
}

model CategoriaRelacion {
  idCategoriaRelacion Int                  @id @default(autoincrement()) @map("id_categoria_relacion")
  codigo              VarChar(50)          @unique
  nombre              VarChar(100)
  descripcion         VarChar(500)?
  orden               Int
  activo              Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           temporal.updatedAt() @map("updated_at")
  invitados           Invitado[]

  @@map("iv_categoria_relacion")
}

model Invitado {
  idInvitado          Uuid                               @id @default(uuid()) @map("id_invitado")
  idMatrimonio        Uuid                               @map("id_matrimonio")
  idPersonaNatural    Int                                @map("id_persona_natural")
  idCategoriaRelacion Int?                               @map("id_categoria_relacion")
  ladoRelacion        iv_lado_relacion                   @default(AMBOS) @map("lado_relacion")
  esTitular           Boolean                            @default(true) @map("es_titular")
  idInvitadoTitular   Uuid?                              @map("id_invitado_titular")
  cantidadPases       Int                                @default(1) @map("cantidad_pases")
  observaciones       VarChar(1000)?
  activo              Boolean                            @default(true)
  createdAt           DateTime                           @default(now()) @map("created_at")
  updatedAt           temporal.updatedAt()               @map("updated_at")
  matrimonio          Matrimonio                         @relation(fields:[idMatrimonio], references:[idMatrimonio], onDelete: Restrict)
  personaNatural      PersonaNatural                     @relation(fields:[idPersonaNatural], references:[idPersonaNatural], onDelete: Restrict)
  categoriaRelacion   CategoriaRelacion?                 @relation(fields:[idCategoriaRelacion], references:[idCategoriaRelacion], onDelete: Restrict)
  titular             Invitado?                          @relation("acompanantes_titular", fields:[idInvitadoTitular], references:[idInvitado], onDelete: Restrict)
  acompanantes        Invitado[]                         @relation("acompanantes_titular")
  requerimientos      InvitadoRequerimientoAlimentario[]
  rsvp                Rsvp?
  asignacionesMesa    MesaInvitado[]

  @@index([idMatrimonio])
  @@index([idPersonaNatural])
  @@index([idCategoriaRelacion])
  @@index([idInvitadoTitular])
  @@index([activo])
  @@unique([idMatrimonio, idPersonaNatural])
  @@map("iv_invitado")
}

model RequerimientoAlimentario {
  idRequerimientoAlimentario Int                                @id @default(autoincrement()) @map("id_requerimiento_alimentario")
  codigo                     VarChar(50)                        @unique
  nombre                     VarChar(100)
  descripcion                VarChar(500)?
  activo                     Boolean                            @default(true)
  createdAt                  DateTime                           @default(now()) @map("created_at")
  updatedAt                  temporal.updatedAt()               @map("updated_at")
  invitados                  InvitadoRequerimientoAlimentario[]

  @@map("iv_requerimiento_alimentario")
}

model InvitadoRequerimientoAlimentario {
  idInvitadoRequerimientoAlimentario Uuid                     @id @default(uuid()) @map("id_invitado_requerimiento_alimentario")
  idInvitado                         Uuid                     @map("id_invitado")
  idRequerimientoAlimentario         Int                      @map("id_requerimiento_alimentario")
  detalle                            VarChar(500)?
  activo                             Boolean                  @default(true)
  createdAt                          DateTime                 @default(now()) @map("created_at")
  updatedAt                          temporal.updatedAt()     @map("updated_at")
  invitado                           Invitado                 @relation(fields:[idInvitado], references:[idInvitado], onDelete: Restrict)
  requerimiento                      RequerimientoAlimentario @relation(fields:[idRequerimientoAlimentario], references:[idRequerimientoAlimentario], onDelete: Restrict)

  @@unique([idInvitado, idRequerimientoAlimentario])
  @@index([idInvitado], map: "iv_inv_req_alim_inv_idx")
  @@index([idRequerimientoAlimentario], map: "iv_inv_req_alim_req_idx")
  @@map("iv_invitado_requerimiento_alimentario")
}

model Rsvp {
  idRsvp                        Uuid                 @id @default(uuid()) @map("id_rsvp")
  idInvitado                    Uuid                 @unique @map("id_invitado")
  estadoRsvp                    iv_estado_rsvp       @default(PENDIENTE) @map("estado_rsvp")
  fechaRespuesta                DateTime?            @map("fecha_respuesta")
  confirmacionDigital           Boolean              @default(false) @map("confirmacion_digital")
  fechaConfirmacionDigital      DateTime?            @map("fecha_confirmacion_digital")
  verificacionManual1           Boolean              @default(false) @map("verificacion_manual_1")
  fechaVerificacionManual1      DateTime?            @map("fecha_verificacion_manual_1")
  idUsuarioVerificacionManual1  Int?                 @map("id_usuario_verificacion_manual_1")
  verificacionManual2           Boolean              @default(false) @map("verificacion_manual_2")
  fechaVerificacionManual2      DateTime?            @map("fecha_verificacion_manual_2")
  idUsuarioVerificacionManual2  Int?                 @map("id_usuario_verificacion_manual_2")
  cantidadAsistentesConfirmados Int?                 @map("cantidad_asistentes_confirmados")
  createdAt                     DateTime             @default(now()) @map("created_at")
  updatedAt                     temporal.updatedAt() @map("updated_at")
  invitado                      Invitado             @relation(fields:[idInvitado], references:[idInvitado], onDelete: Restrict)
  usuarioVerificacionManual1    Usuario?             @relation("rsvp_verificacion_1", fields:[idUsuarioVerificacionManual1], references:[idUsuario], onDelete: Restrict)
  usuarioVerificacionManual2    Usuario?             @relation("rsvp_verificacion_2", fields:[idUsuarioVerificacionManual2], references:[idUsuario], onDelete: Restrict)
  historial                     RsvpHistorial[]

  @@index([estadoRsvp])
  @@map("iv_rsvp")
}

model RsvpHistorial {
  idRsvpHistorial Uuid            @id @default(uuid()) @map("id_rsvp_historial")
  idRsvp          Uuid            @map("id_rsvp")
  estadoAnterior  iv_estado_rsvp? @map("estado_anterior")
  estadoNuevo     iv_estado_rsvp  @map("estado_nuevo")
  canal           iv_canal_rsvp
  fechaCambio     DateTime        @default(now()) @map("fecha_cambio")
  idUsuario       Int?            @map("id_usuario")
  observacion     VarChar(1000)?
  createdAt       DateTime        @default(now()) @map("created_at")
  rsvp            Rsvp            @relation(fields:[idRsvp], references:[idRsvp], onDelete: Restrict)
  usuario         Usuario?        @relation("rsvp_historial_usuario", fields:[idUsuario], references:[idUsuario], onDelete: Restrict)

  @@index([idRsvp])
  @@index([fechaCambio])
  @@map("iv_rsvp_historial")
}

model Mesa {
  idMesa        Uuid                 @id @default(uuid()) @map("id_mesa")
  idMatrimonio  Uuid                 @map("id_matrimonio")
  nombre        VarChar(100)
  numero        Int?
  capacidad     Int
  ubicacion     VarChar(250)?
  observaciones VarChar(1000)?
  activo        Boolean              @default(true)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     temporal.updatedAt() @map("updated_at")
  matrimonio    Matrimonio           @relation(fields:[idMatrimonio], references:[idMatrimonio], onDelete: Restrict)
  asignaciones  MesaInvitado[]

  @@index([idMatrimonio])
  @@map("iv_mesa")
}

model MesaInvitado {
  idMesaInvitado Uuid                 @id @default(uuid()) @map("id_mesa_invitado")
  idMesa         Uuid                 @map("id_mesa")
  idInvitado     Uuid                 @map("id_invitado")
  numeroAsiento  Int?                 @map("numero_asiento")
  observacion    VarChar(500)?
  activo         Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      temporal.updatedAt() @map("updated_at")
  mesa           Mesa                 @relation(fields:[idMesa], references:[idMesa], onDelete: Restrict)
  invitado       Invitado             @relation(fields:[idInvitado], references:[idInvitado], onDelete: Restrict)

  @@unique([idMesa, idInvitado])
  @@index([idMesa])
  @@index([idInvitado])
  @@map("iv_mesa_invitado")
}

enum cr_prioridad_actividad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum cr_tipo_dependencia {
  FINISH_TO_START
}

enum cr_estado_hito {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  NO_APLICA
}

enum cr_estado_actividad {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
  NO_APLICA
}

enum nt_tipo_evento_cronograma {
  ACTIVIDAD_PROXIMA_VENCER
  ACTIVIDAD_VENCIDA
  ACTIVIDAD_REPROGRAMADA
  HITO_PROXIMO
  HITO_VENCIDO
}

model PlantillaHito {
  idPlantillaHito    Int                  @id @default(autoincrement()) @map("id_plantilla_hito")
  codigo             VarChar(50)          @unique
  nombre             VarChar(200)
  criterioAceptacion VarChar(1000)        @map("criterio_aceptacion")
  tipoTemporal       cr_tipo_temporal     @map("tipo_temporal")
  diasAntesBase      Int?                 @map("dias_antes_base")
  diasAntesMinimo    Int?                 @map("dias_antes_minimo")
  orden              Int
  activo             Boolean              @default(true)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          temporal.updatedAt() @map("updated_at")
  actividades        PlantillaActividad[]
  hitosOrigen        Hito[]

  @@map("cr_plantilla_hito")
}

model PlantillaActividad {
  idPlantillaActividad    Int                               @id @default(autoincrement()) @map("id_plantilla_actividad")
  idPlantillaHito         Int?                              @map("id_plantilla_hito")
  idFaseProyecto          Int                               @map("id_fase_proyecto")
  codigo                  VarChar(50)                       @unique
  nombre                  VarChar(200)
  listaVerificacion       Json?                             @map("lista_verificacion")
  responsableSugerido     VarChar(150)?                     @map("responsable_sugerido")
  entregable              VarChar(500)?
  tipoTemporal            cr_tipo_temporal                  @map("tipo_temporal")
  diasAntesBase           Int?                              @map("dias_antes_base")
  diasAntesMinimo         Int?                              @map("dias_antes_minimo")
  duracionEstimadaDias    Int?                              @map("duracion_estimada_dias")
  prioridad               cr_prioridad_actividad?
  orden                   Int
  activo                  Boolean                           @default(true)
  createdAt               DateTime                          @default(now()) @map("created_at")
  updatedAt               temporal.updatedAt()              @map("updated_at")
  hito                    PlantillaHito?                    @relation(fields:[idPlantillaHito], references:[idPlantillaHito], onDelete: Restrict)
  faseProyecto            FaseProyecto                      @relation(fields:[idFaseProyecto], references:[idFaseProyecto], onDelete: Restrict)
  tiposCeremonia          PlantillaActividadTipoCeremonia[]
  dependenciasPredecesora PlantillaDependencia[]            @relation("plantilla_pre")
  dependenciasSucesora    PlantillaDependencia[]            @relation("plantilla_suc")

  @@index([idPlantillaHito])
  @@index([idFaseProyecto])
  actividadesOrigen       Actividad[]

  @@map("cr_plantilla_actividad")
}

model PlantillaActividadTipoCeremonia {
  idPlantillaActividadTipoCeremonia Int                @id @default(autoincrement()) @map("id_plantilla_actividad_tipo_ceremonia")
  idPlantillaActividad              Int                @map("id_plantilla_actividad")
  idTipoCeremonia                   Int                @map("id_tipo_ceremonia")
  actividad                         PlantillaActividad @relation(fields:[idPlantillaActividad], references:[idPlantillaActividad], onDelete: Restrict)
  tipoCeremonia                     TipoCeremonia      @relation(fields:[idTipoCeremonia], references:[idTipoCeremonia], onDelete: Restrict)

  @@unique([idPlantillaActividad, idTipoCeremonia])
  @@map("cr_plantilla_actividad_tipo_ceremonia")
}

model PlantillaDependencia {
  idPlantillaDependencia Int                 @id @default(autoincrement()) @map("id_plantilla_dependencia")
  idActividadPredecesora Int                 @map("id_actividad_predecesora")
  idActividadSucesora    Int                 @map("id_actividad_sucesora")
  tipoDependencia        cr_tipo_dependencia @default(FINISH_TO_START) @map("tipo_dependencia")
  diasDesfase            Int                 @default(0) @map("dias_desfase")
  predecesora            PlantillaActividad  @relation("plantilla_pre", fields:[idActividadPredecesora], references:[idPlantillaActividad], onDelete: Restrict)
  sucesora               PlantillaActividad  @relation("plantilla_suc", fields:[idActividadSucesora], references:[idPlantillaActividad], onDelete: Restrict)

  @@unique([idActividadPredecesora, idActividadSucesora])
  @@map("cr_plantilla_dependencia")
}

model PlantillaTiming {
  idPlantillaTiming   Int                            @id @default(autoincrement()) @map("id_plantilla_timing")
  codigo              VarChar(50)                    @unique
  horaInicio          Time                           @map("hora_inicio")
  duracionMinutos     Int                            @map("duracion_minutos")
  actividad           VarChar(200)
  responsableSugerido VarChar(150)?                  @map("responsable_sugerido")
  listaVerificacion   Json?                          @map("lista_verificacion")
  orden               Int
  activo              Boolean                        @default(true)
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           temporal.updatedAt()           @map("updated_at")
  tiposCeremonia      PlantillaTimingTipoCeremonia[]
  timingsOrigen       Timing[]

  @@map("cr_plantilla_timing")
}

model PlantillaTimingTipoCeremonia {
  idPlantillaTimingTipoCeremonia Int             @id @default(autoincrement()) @map("id_plantilla_timing_tipo_ceremonia")
  idPlantillaTiming              Int             @map("id_plantilla_timing")
  idTipoCeremonia                Int             @map("id_tipo_ceremonia")
  timing                         PlantillaTiming @relation(fields:[idPlantillaTiming], references:[idPlantillaTiming], onDelete: Restrict)
  tipoCeremonia                  TipoCeremonia   @relation(fields:[idTipoCeremonia], references:[idTipoCeremonia], onDelete: Restrict)

  @@unique([idPlantillaTiming, idTipoCeremonia])
  @@map("cr_plantilla_timing_tipo_ceremonia")
}

model Hito {
  idHito                Uuid                     @id @default(uuid()) @map("id_hito")
  idProyecto            Uuid                     @map("id_proyecto")
  idPlantillaHito       Int?                     @map("id_plantilla_hito")
  nombre                VarChar(200)
  criterioAceptacion    VarChar(1000)?           @map("criterio_aceptacion")
  fechaObjetivo         DateTime                 @map("fecha_objetivo")
  estado                cr_estado_hito           @default(PENDIENTE)
  orden                 Int
  modificadoManualmente Boolean                  @default(false) @map("modificado_manualmente")
  activo                Boolean                  @default(true)
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             temporal.updatedAt()     @map("updated_at")

  proyecto              Proyecto                 @relation(fields:[idProyecto], references:[idProyecto], onDelete: Restrict)
  plantillaHito         PlantillaHito?           @relation(fields:[idPlantillaHito], references:[idPlantillaHito], onDelete: Restrict)
  actividades           Actividad[]
  notificaciones        NotificacionCronograma[]

  @@index([idProyecto])
  @@index([idPlantillaHito])
  @@index([estado])
  @@map("cr_hito")
}

model Actividad {
  idActividad             Uuid                     @id @default(uuid()) @map("id_actividad")
  idProyecto              Uuid                     @map("id_proyecto")
  idHito                  Uuid?                    @map("id_hito")
  idPlantillaActividad    Int?                     @map("id_plantilla_actividad")
  nombre                  VarChar(200)
  descripcion             VarChar(1000)?
  listaVerificacion       Json?                    @map("lista_verificacion")
  entregable              VarChar(500)?
  fechaInicio             DateTime?                @map("fecha_inicio")
  fechaFin                DateTime                 @map("fecha_fin")
  prioridad               cr_prioridad_actividad?
  estado                  cr_estado_actividad      @default(PENDIENTE)
  idUsuarioResponsable    Int?                     @map("id_usuario_responsable")
  responsableTexto        VarChar(150)?            @map("responsable_texto")
  orden                   Int
  modificadoManualmente   Boolean                  @default(false) @map("modificado_manualmente")
  activo                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               temporal.updatedAt()     @map("updated_at")

  proyecto                Proyecto                 @relation(fields:[idProyecto], references:[idProyecto], onDelete: Restrict)
  hito                    Hito?                    @relation(fields:[idHito], references:[idHito], onDelete: Restrict)
  plantillaActividad      PlantillaActividad?      @relation(fields:[idPlantillaActividad], references:[idPlantillaActividad], onDelete: Restrict)
  responsable             Usuario?                 @relation("actividades_responsable", fields:[idUsuarioResponsable], references:[idUsuario], onDelete: Restrict)
  dependenciasPredecesora Dependencia[]            @relation("actividades_predecesora")
  dependenciasSucesora    Dependencia[]            @relation("actividades_sucesora")
  notificaciones          NotificacionCronograma[]

  @@index([idProyecto])
  @@index([idHito])
  @@index([idPlantillaActividad])
  @@index([idUsuarioResponsable])
  @@index([estado])
  @@index([fechaInicio])
  @@index([fechaFin])
  @@map("cr_actividad")
}

model Dependencia {
  idDependencia          Uuid                @id @default(uuid()) @map("id_dependencia")
  idActividadPredecesora Uuid                @map("id_actividad_predecesora")
  idActividadSucesora    Uuid                @map("id_actividad_sucesora")
  tipoDependencia        cr_tipo_dependencia @default(FINISH_TO_START) @map("tipo_dependencia")
  diasDesfase            Int                 @default(0) @map("dias_desfase")

  predecesora            Actividad           @relation("actividades_predecesora", fields:[idActividadPredecesora], references:[idActividad], onDelete: Restrict)
  sucesora               Actividad           @relation("actividades_sucesora", fields:[idActividadSucesora], references:[idActividad], onDelete: Restrict)

  @@unique([idActividadPredecesora, idActividadSucesora])
  @@index([idActividadPredecesora])
  @@index([idActividadSucesora])
  @@map("cr_dependencia")
}

model Timing {
  idTiming              Uuid                 @id @default(uuid()) @map("id_timing")
  idProyecto            Uuid                 @map("id_proyecto")
  idPlantillaTiming     Int?                 @map("id_plantilla_timing")
  actividad             VarChar(200)
  fechaHoraInicio       DateTime             @map("fecha_hora_inicio")
  fechaHoraFin          DateTime             @map("fecha_hora_fin")
  duracionMinutos       Int                  @map("duracion_minutos")
  idUsuarioResponsable  Int?                 @map("id_usuario_responsable")
  responsableTexto      VarChar(150)?        @map("responsable_texto")
  listaVerificacion     Json?                @map("lista_verificacion")
  estado                cr_estado_actividad  @default(PENDIENTE)
  orden                 Int
  modificadoManualmente Boolean              @default(false) @map("modificado_manualmente")
  activo                Boolean              @default(true)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             temporal.updatedAt() @map("updated_at")

  proyecto              Proyecto             @relation(fields:[idProyecto], references:[idProyecto], onDelete: Restrict)
  plantillaTiming       PlantillaTiming?     @relation(fields:[idPlantillaTiming], references:[idPlantillaTiming], onDelete: Restrict)
  responsable           Usuario?             @relation("timings_responsable", fields:[idUsuarioResponsable], references:[idUsuario], onDelete: Restrict)

  @@index([idProyecto])
  @@index([idPlantillaTiming])
  @@index([idUsuarioResponsable])
  @@index([estado])
  @@index([fechaHoraInicio])
  @@index([fechaHoraFin])
  @@map("cr_timing")
}

model Notificacion {
  idNotificacion   Uuid                    @id @default(uuid()) @map("id_notificacion")
  idUsuarioDestino Int                     @map("id_usuario_destino")
  idProyecto       Uuid?                   @map("id_proyecto")
  tipo             VarChar(50)
  titulo           VarChar(200)
  mensaje          VarChar(1000)
  fechaGeneracion  DateTime                @default(now()) @map("fecha_generacion")
  fechaProgramada  DateTime?               @map("fecha_programada")
  leida            Boolean                 @default(false)
  enviadaPush      Boolean                 @default(false) @map("enviada_push")
  activo           Boolean                 @default(true)
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        temporal.updatedAt()    @map("updated_at")

  usuarioDestino   Usuario                 @relation("notificaciones_destino", fields:[idUsuarioDestino], references:[idUsuario], onDelete: Restrict)
  proyecto         Proyecto?               @relation(fields:[idProyecto], references:[idProyecto], onDelete: Restrict)
  cronograma       NotificacionCronograma?

  @@index([idUsuarioDestino])
  @@index([idProyecto])
  @@index([leida])
  @@index([activo])
  @@map("nt_notificacion")
}

model NotificacionCronograma {
  idNotificacion       Uuid                      @id @map("id_notificacion")
  idActividad          Uuid?                     @map("id_actividad")
  idHito               Uuid?                     @map("id_hito")
  tipoEventoCronograma nt_tipo_evento_cronograma @map("tipo_evento_cronograma")
  fechaReferencia      DateTime?                 @map("fecha_referencia")

  notificacion         Notificacion              @relation(fields:[idNotificacion], references:[idNotificacion], onDelete: Restrict)
  actividad            Actividad?                @relation(fields:[idActividad], references:[idActividad], onDelete: Restrict)
  hito                 Hito?                     @relation(fields:[idHito], references:[idHito], onDelete: Restrict)

  @@index([idActividad])
  @@index([idHito])
  @@index([tipoEventoCronograma])
  @@map("nt_notificacion_cronograma")
}

model Proveedor {
  idProveedor      Uuid                      @id @default(uuid()) @map("id_proveedor")
  tipoProveedor    pv_tipo_proveedor         @map("tipo_proveedor")
  idPersonaNatural Int?                      @unique @map("id_persona_natural")
  idEntidad        Int?                      @unique @map("id_entidad")
  nombreComercial  VarChar(200)              @map("nombre_comercial")
  descripcion      VarChar(1000)?
  telefonoContacto VarChar(15)?              @map("telefono_contacto")
  whatsapp         VarChar(15)?
  correoContacto   VarChar(150)?             @map("correo_contacto")
  sitioWeb         VarChar(250)?             @map("sitio_web")
  instagram        VarChar(150)?
  direccion        VarChar(250)?
  observaciones    VarChar(1000)?
  activo           Boolean                   @default(true)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        temporal.updatedAt()      @map("updated_at")
  personaNatural   PersonaNatural?           @relation(fields:[idPersonaNatural], references:[idPersonaNatural], onDelete: Restrict)
  entidad          Entidad?                  @relation(fields:[idEntidad], references:[idEntidad], onDelete: Restrict)
  servicios        ProveedorServicio[]
  matrimonios      MatrimonioProveedor[]
  disponibilidades DisponibilidadProveedor[]

  @@index([activo])
  @@index([nombreComercial])
  @@map("pv_proveedor")
}

model CategoriaServicio {
  idCategoriaServicio Int                  @id @default(autoincrement()) @map("id_categoria_servicio")
  codigo              VarChar(50)          @unique
  nombre              VarChar(100)
  descripcion         VarChar(500)?
  orden               Int
  activo              Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           temporal.updatedAt() @map("updated_at")
  servicios           ProveedorServicio[]

  @@index([activo])
  @@map("pv_categoria_servicio")
}

model ProveedorServicio {
  idProveedorServicio Int                       @id @default(autoincrement()) @map("id_proveedor_servicio")
  idProveedor         Uuid                      @map("id_proveedor")
  idCategoriaServicio Int                       @map("id_categoria_servicio")
  nombre              VarChar(200)
  descripcion         VarChar(1000)?
  costoReferencial    Numeric(12, 2)            @map("costo_referencial")
  moneda              pv_moneda                 @default(PEN)
  unidadPrecio        VarChar(50)?              @map("unidad_precio")
  activo              Boolean                   @default(true)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           temporal.updatedAt()      @map("updated_at")
  proveedor           Proveedor                 @relation(fields:[idProveedor], references:[idProveedor], onDelete: Restrict)
  categoriaServicio   CategoriaServicio         @relation(fields:[idCategoriaServicio], references:[idCategoriaServicio], onDelete: Restrict)
  disponibilidades    DisponibilidadProveedor[]

  @@unique([idProveedor, idCategoriaServicio, nombre])
  @@index([idProveedor])
  @@index([idCategoriaServicio])
  @@map("pv_proveedor_servicio")
}

model MatrimonioProveedor {
  idMatrimonioProveedor Uuid                 @id @default(uuid()) @map("id_matrimonio_proveedor")
  idMatrimonio          Uuid                 @map("id_matrimonio")
  idProveedor           Uuid                 @map("id_proveedor")
  favorito              Boolean              @default(false)
  estadoSeleccion       pv_estado_seleccion  @default(CONSIDERADO) @map("estado_seleccion")
  prioridad             pv_prioridad?
  observaciones         VarChar(1000)?
  activo                Boolean              @default(true)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             temporal.updatedAt() @map("updated_at")
  matrimonio            Matrimonio           @relation(fields:[idMatrimonio], references:[idMatrimonio], onDelete: Restrict)
  proveedor             Proveedor            @relation(fields:[idProveedor], references:[idProveedor], onDelete: Restrict)

  @@unique([idMatrimonio, idProveedor])
  @@index([idMatrimonio])
  @@index([idProveedor])
  @@index([favorito])
  @@index([estadoSeleccion])
  @@map("pv_matrimonio_proveedor")
}

model DisponibilidadProveedor {
  idDisponibilidadProveedor Uuid                 @id @default(uuid()) @map("id_disponibilidad_proveedor")
  idProveedor               Uuid                 @map("id_proveedor")
  idProveedorServicio       Int?                 @map("id_proveedor_servicio")
  fecha                     DateTime
  disponible                Boolean              @default(true)
  horaInicio                Time?                @map("hora_inicio")
  horaFin                   Time?                @map("hora_fin")
  observacion               VarChar(1000)?
  activo                    Boolean              @default(true)
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 temporal.updatedAt() @map("updated_at")
  proveedor                 Proveedor            @relation(fields:[idProveedor], references:[idProveedor], onDelete: Restrict)
  proveedorServicio         ProveedorServicio?   @relation(fields:[idProveedorServicio], references:[idProveedorServicio], onDelete: Restrict)

  @@index([idProveedor, fecha])
  @@index([idProveedorServicio, fecha], map: "pv_disp_serv_fecha_idx")
  @@map("pv_disponibilidad_proveedor")
}

model Ubigeo {
  idUbigeo     VarChar(6)       @id @map("id_ubigeo")
  departamento VarChar(100)
  provincia    VarChar(100)
  distrito     VarChar(100)

  personas     PersonaNatural[]
  entidades    Entidad[]
  matrimonios  Matrimonio[]

  @@map("in_ubigeo")
}

enum in_tipo_entidad {
  PUBLICA = "PUBLICA"
  PRIVADA = "PRIVADA"
  RELIGIOSA = "RELIGIOSA"
  OTROS = "OTROS"
}

model PersonaNatural {
  idPersonaNatural  Int                  @id @default(autoincrement()) @map("id_persona_natural")
  nombres           VarChar(100)
  apellidoPaterno   VarChar(100)         @map("apellido_paterno")
  apellidoMaterno   VarChar(100)?        @map("apellido_materno")
  telefono          VarChar(15)?
  correoElectronico VarChar(150)         @map("correo_electronico")
  dni               VarChar(8)?          @unique
  direccion         VarChar(250)?
  codigoUbigeo      VarChar(6)?          @map("codigo_ubigeo")
  esActivo          Boolean              @default(true) @map("es_activo")
  fechaCreacion     DateTime             @default(now()) @map("fecha_creacion")
  fechaModificacion temporal.updatedAt() @map("fecha_modificacion")

  ubigeo            Ubigeo?              @relation(fields:[codigoUbigeo], references:[idUbigeo], onDelete: Restrict)
  usuarios          Usuario[]
  invitados         Invitado[]
  proveedores       Proveedor[]

  @@index([codigoUbigeo], map: "in_persona_natural_codigo_ubigeo_idx")
  @@map("in_persona_natural")
}

model Entidad {
  idEntidad         Int                  @id @default(autoincrement()) @map("id_entidad")
  ruc               VarChar(11)?         @unique
  razonSocial       VarChar(200)?        @map("razon_social")
  nombreComercial   VarChar(200)         @map("nombre_comercial")
  tipoEntidad       in_tipo_entidad      @map("tipo_entidad")
  telefono          VarChar(15)?
  correoElectronico VarChar(150)?        @map("correo_electronico")
  redesSociales     VarChar(250)?        @map("redes_sociales")
  direccion         VarChar(250)?
  codigoUbigeo      VarChar(6)?          @map("codigo_ubigeo")
  esActivo          Boolean              @default(true) @map("es_activo")
  fechaCreacion     DateTime             @default(now()) @map("fecha_creacion")
  fechaModificacion temporal.updatedAt() @map("fecha_modificacion")

  ubigeo            Ubigeo?              @relation(fields:[codigoUbigeo], references:[idUbigeo], onDelete: Restrict)
  usuarios          Usuario[]
  proveedores       Proveedor[]

  @@index([codigoUbigeo])
  @@map("in_entidad")
}

enum au_tipo_usuario {
  PROJECT_MANAGER = "PROJECT_MANAGER"
  OTROS = "OTROS"
}

enum au_tipo_token_cuenta {
  VERIFICACION_CORREO = "VERIFICACION_CORREO"
  RECUPERACION_CONTRASENA = "RECUPERACION_CONTRASENA"
}

model Usuario {
  idUsuario                Int                  @id @default(autoincrement()) @map("id_usuario")
  idPersonaNatural         Int                  @map("id_persona_natural")
  idEntidad                Int?                 @map("id_entidad")
  usuario                  VarChar(150)         @unique
  tipoUsuario              au_tipo_usuario      @map("tipo_usuario")
  contrasenaHash           VarChar(255)         @map("contrasena_hash")
  correoVerificado         Boolean              @default(false) @map("correo_verificado")
  esActivo                 Boolean              @default(true) @map("es_activo")
  ultimoAcceso             DateTime             @map("ultimo_acceso")
  fechaCreacion            DateTime             @default(now()) @map("fecha_creacion")
  fechaModificacion        temporal.updatedAt() @map("fecha_modificacion")

  personaNatural           PersonaNatural       @relation(fields:[idPersonaNatural], references:[idPersonaNatural], onDelete: Restrict)
  entidad                  Entidad?             @relation(fields:[idEntidad], references:[idEntidad], onDelete: Restrict)
  sesiones                 Sesion[]
  tokensCuenta             TokenCuenta[]
  proyectosPm              Proyecto[]           @relation("proyectos_pm")
  matrimoniosNovio1        Matrimonio[]         @relation("matrimonios_novio1")
  matrimoniosNovio2        Matrimonio[]         @relation("matrimonios_novio2")
  actividadesResponsable   Actividad[]          @relation("actividades_responsable")
  timingsResponsable       Timing[]             @relation("timings_responsable")
  notificacionesDestino    Notificacion[]       @relation("notificaciones_destino")
  rsvpsVerificacionManual1 Rsvp[]               @relation("rsvp_verificacion_1")
  rsvpsVerificacionManual2 Rsvp[]               @relation("rsvp_verificacion_2")
  historialRsvp            RsvpHistorial[]      @relation("rsvp_historial_usuario")

  @@index([idPersonaNatural])
  @@index([idEntidad])
  @@map("au_usuario")
}

model Sesion {
  idSesion         Int          @id @default(autoincrement()) @map("id_sesion")
  idUsuario        Int          @map("id_usuario")
  refreshTokenHash VarChar(255) @map("refresh_token_hash")
  fechaCreacion    DateTime     @default(now()) @map("fecha_creacion")
  fechaExpiracion  DateTime     @map("fecha_expiracion")
  fechaRevocacion  DateTime?    @map("fecha_revocacion")

  usuario          Usuario      @relation(fields:[idUsuario], references:[idUsuario], onDelete: Restrict)

  @@index([idUsuario])
  @@map("au_sesion")
}

model TokenCuenta {
  idToken          Int                  @id @default(autoincrement()) @map("id_token")
  idUsuario        Int                  @map("id_usuario")
  tipoToken        au_tipo_token_cuenta @map("tipo_token")
  tokenHash        VarChar(255)         @map("token_hash")
  fechaCreacion    DateTime             @default(now()) @map("fecha_creacion")
  fechaExpiracion  DateTime             @map("fecha_expiracion")
  fechaUtilizacion DateTime?            @map("fecha_utilizacion")

  usuario          Usuario              @relation(fields:[idUsuario], references:[idUsuario], onDelete: Restrict)

  @@index([idUsuario, tipoToken])
  @@map("au_token_cuenta")
}

model RegistroPendiente {
  idRegistro        Int           @id @default(autoincrement()) @map("id_registro")
  nombres           VarChar(100)
  apellidoPaterno   VarChar(100)  @map("apellido_paterno")
  apellidoMaterno   VarChar(100)? @map("apellido_materno")
  correoElectronico VarChar(150)  @map("correo_electronico")
  tokenHash         VarChar(255)  @map("token_hash")
  fechaCreacion     DateTime      @default(now()) @map("fecha_creacion")
  fechaExpiracion   DateTime      @map("fecha_expiracion")
  fechaVerificacion DateTime?     @map("fecha_verificacion")

  @@index([correoElectronico])
  @@map("au_registro_pendiente")
}
